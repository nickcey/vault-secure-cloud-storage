# ═══════════════════════════════════════════════════════════
# VAULT SECURE CLOUD STORAGE - Configuration Environnement
# ═══════════════════════════════════════════════════════════
# 📝 TEMPLATE : Copiez ce fichier en .env et remplissez avec vos vraies valeurs
# ═══════════════════════════════════════════════════════════

# ─── Environnement ─────────────────────────────────────────
# Valeurs possibles: development, production
FLASK_ENV=development
FLASK_DEBUG=True

# ─── Sécurité ──────────────────────────────────────────────
# Générer une clé aléatoire avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-generate-a-random-one

# ─── Email (Gmail) ─────────────────────────────────────────
# Pour Gmail, créer un "App Password" : https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password-here

# ─── Campay Payment Gateway ────────────────────────────────
# Obtenir credentials sur : https://www.campay.net/
CAMPAY_APP_USERNAME=your-campay-username-here
CAMPAY_APP_PASSWORD=your-campay-password-here
CAMPAY_BASE_URL=https://demo.campay.net/api

# ─── Base de données ───────────────────────────────────────
# PostgreSQL (production recommandé)
# DATABASE_URL=postgresql://user:password@localhost:5432/vault_db

# SQLite (développement - par défaut si DATABASE_URL n'est pas défini)
# Pas besoin de variable, automatiquement configuré

